{
  "name": "minikit-tools",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-locales.mjs && node scripts/generate-tool-pages.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test:locales": "node --test tests/locales.test.mjs",
    "test:tools": "node --experimental-strip-types --test tests/text-tools.test.mjs tests/developer-tools.test.mjs tests/everyday-tools.test.mjs tests/image-geometry.test.mjs"
  },
  "dependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.14.1",
    "lucide-astro": "^0.468.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.2"
  }
}
