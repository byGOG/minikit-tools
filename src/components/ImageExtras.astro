---
import {Stamp, Palette, FileCode, ShieldCheck, ArrowRight} from 'lucide-astro';
import tr from '../i18n/locales/tr.json';
const cards=[{id:'watermark',title:'watermarkTitle',desc:'watermarkDesc',slug:'image-watermark',Icon:Stamp},{id:'palette',title:'paletteTitle',desc:'paletteDesc',slug:'image-color-palette',Icon:Palette},{id:'image64',title:'image64Title',desc:'image64Desc',slug:'image-to-base64',Icon:FileCode}] as const;
---
{cards.map(({id,title,desc,slug,Icon})=>(<article class="tool-card text-tool-card image-editor-card" id={`${id}-tool`}>
 <div class="card-top"><span class="tool-icon icon-green"><Icon size={20}/></span><span class="tag-free" data-i18n="free">{tr.free}</span></div>
 <h3 data-i18n={title}>{tr[title]}</h3><p data-i18n={desc}>{tr[desc]}</p>
 <label class="field-label" for={`${id}-file`} data-i18n="editorFile">{tr.editorFile}</label>
 <input class="text-input" id={`${id}-file`} type="file" accept="image/png,image/jpeg,image/webp" aria-describedby={`${id}-limits`}/>
 <small class="number-hint" id={`${id}-limits`} data-i18n={id==='image64'?'image64Limits':'editorLimits'}>{id==='image64'?tr.image64Limits:tr.editorLimits}</small>
 {id==='watermark'&&<div id="watermark-options">
  <label class="field-label" for="watermark-text" data-i18n="watermarkText">{tr.watermarkText}</label><input class="text-input" id="watermark-text" maxlength="140" value="MiniKit"/>
  <label class="field-label" for="watermark-size" data-i18n="watermarkSize">{tr.watermarkSize}</label><input class="text-input" id="watermark-size" type="number" min="2" max="15" value="6"/>
  <label class="field-label" for="watermark-opacity" data-i18n="watermarkOpacity">{tr.watermarkOpacity}</label><input class="text-input" id="watermark-opacity" type="number" min="10" max="100" value="70"/>
  <label class="field-label" for="watermark-color" data-i18n="chooseColor">{tr.chooseColor}</label><input id="watermark-color" type="color" value="#ffffff"/>
  <label class="field-label" for="watermark-position" data-i18n="watermarkPosition">{tr.watermarkPosition}</label><select class="text-input" id="watermark-position">{[['tl','positionTL'],['tr','positionTR'],['bl','positionBL'],['br','positionBR'],['center','positionCenter']].map(([value,key])=><option value={value} selected={value==='br'} data-i18n={key}>{tr[key as keyof typeof tr]}</option>)}</select>
  <small class="number-hint" data-i18n="watermarkHint">{tr.watermarkHint}</small>
 </div>}
 {id==='palette'&&<small class="number-hint" data-i18n="paletteHint">{tr.paletteHint}</small>}
 <button class="button-primary full" id={`${id}-apply`} data-i18n={id==='watermark'?'watermarkApply':id==='palette'?'paletteExtract':'image64Convert'} disabled>{id==='watermark'?tr.watermarkApply:id==='palette'?tr.paletteExtract:tr.image64Convert}</button>
 <div class="editor-preview"><img id={`${id}-preview`} hidden alt={tr[title]} data-i18n-alt={title}/></div>
 {id==='palette'&&<div class="palette-swatches" id="palette-colors"></div>}
 {id!=='watermark'&&<><label class="field-label" for={`${id}-output`} data-i18n="textResult">{tr.textResult}</label><textarea class="text-input textarea" id={`${id}-output`} readonly wrap="off"/><button class="button-secondary full" id={`${id}-copy`} data-i18n="copyResult" disabled>{tr.copyResult}</button></>}
 <p class="tool-feedback" id={`${id}-feedback`} role="status"></p>
 <button class="button-secondary full" id={`${id}-download`} data-i18n={id==='watermark'?'downloadPng':id==='palette'?'paletteDownload':'image64Download'} disabled>{id==='watermark'?tr.downloadPng:id==='palette'?tr.paletteDownload:tr.image64Download}</button>
 <div class="card-meta"><ShieldCheck size={14}/><span data-i18n="localImage">{tr.localImage}</span></div><a class="tool-more" data-tool-page={slug} href="#tools"><span data-i18n="navCta">{tr.navCta}</span><ArrowRight size={14}/></a>
</article>))}
<style is:global>
 #watermark-options{display:flex;flex-direction:column;gap:7px}#watermark-color{width:100%;height:32px;border:1px solid #e2e9e1;border-radius:8px;background:#fff}.palette-swatches{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;margin:10px 0}.palette-swatch{display:flex;flex-direction:column;gap:5px;font-size:10px}.palette-swatch i{height:35px;border:1px solid #0002;border-radius:7px}.palette-swatch code{overflow-wrap:anywhere}.image-editor-card .editor-preview img[hidden]{display:none}
</style>
