---
import{Wrench,ShieldCheck,ArrowRight}from'lucide-astro';import tr from'../i18n/locales/tr.json';
const cards=[['reading','reading-time'],['frequency','word-frequency'],['picker','random-list-picker'],['xmlformat','xml-formatter'],['urlparse','url-parser'],['contrast','color-contrast-checker']];const str=(key:string)=>tr[key as keyof typeof tr];
---
{cards.map(([id,slug])=><article class="tool-card text-tool-card" id={`${id}-pack-tool`}><div class="card-top"><span class="tool-icon icon-lilac"><Wrench size={20}/></span><span class="tag-free" data-i18n="free">{tr.free}</span></div><h3 data-i18n={id+'Title'}>{str(id+'Title')}</h3><p data-i18n={id+'Desc'}>{str(id+'Desc')}</p><div class="pack-options" id={`${id}-pack-options`}>
{id!=='contrast'&&<><label class="field-label" for={`${id}-pack-input`} data-i18n="textInput">{tr.textInput}</label><textarea class="text-input textarea" id={`${id}-pack-input`} maxlength="100000" spellcheck="false" dir="auto"></textarea></>}
{id==='reading'&&<><label class="field-label" for="reading-wpm" data-i18n="readingWpm">{str('readingWpm')}</label><input class="text-input" type="number" id="reading-wpm" min="80" max="1000" step="1" value="200"/></>}
{id==='picker'&&<><label class="field-label" for="picker-count" data-i18n="pickerCount">{str('pickerCount')}</label><input class="text-input" type="number" id="picker-count" min="1" max="100" step="1" value="1"/></>}
{id==='contrast'&&<>{[['fg','contrastForeground','#000000'],['bg','contrastBackground','#ffffff']].map(([key,label,value])=><><label class="field-label" for={`contrast-${key}`} data-i18n={label}>{str(label)}</label><input class="text-input" type="color" id={`contrast-${key}`} value={value}/></>)}</>}
</div><small class="number-hint" data-i18n={id+'Hint'}>{str(id+'Hint')}</small>{id==='contrast'&&<a class="tool-more" href="https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html" target="_blank" rel="noopener noreferrer">WCAG · W3C</a>}<button class="button-primary full" id={`${id}-pack-apply`} data-i18n="utilityApply">{tr.utilityApply}</button><label class="field-label" for={`${id}-pack-output`} data-i18n="textResult">{tr.textResult}</label><textarea class="text-input textarea text-result" id={`${id}-pack-output`} readonly dir="auto"></textarea><p class="tool-feedback" id={`${id}-pack-feedback`} role="status"></p><div class="text-tool-actions"><button class="button-secondary full" id={`${id}-pack-copy`} data-i18n="copyResult" disabled>{tr.copyResult}</button><button class="button-secondary full" id={`${id}-pack-clear`} data-i18n="clearText">{tr.clearText}</button></div><div class="card-meta"><ShieldCheck size={14}/><span data-i18n="localWord">{tr.localWord}</span></div><a class="tool-more" data-tool-page={slug} href="#tools"><span data-i18n="navCta">{tr.navCta}</span><ArrowRight size={14}/></a></article>)}
<style is:global>.pack-options{display:flex;flex-direction:column;gap:7px;margin-bottom:10px}</style>
