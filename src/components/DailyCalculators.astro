---
import{Tags,Scale,Gauge,ShieldCheck,ArrowRight}from'lucide-astro';import tr from'../i18n/locales/tr.json';
const cards=[{id:'discount',title:'discountTitle',desc:'discountDesc',hint:'discountHint',slug:'discount-calculator',Icon:Tags},{id:'proportion',title:'proportionTitle',desc:'proportionDesc',hint:'proportionHint',slug:'proportion-calculator',Icon:Scale},{id:'travel',title:'travelTitle',desc:'travelDesc',hint:'travelHint',slug:'speed-distance-time',Icon:Gauge}]as const;
---
{cards.map(({id,title,desc,hint,slug,Icon})=><article class="tool-card text-tool-card" id={`${id}-daily-tool`}>
<div class="card-top"><span class="tool-icon icon-green"><Icon size={20}/></span><span class="tag-free" data-i18n="free">{tr.free}</span></div><h3 data-i18n={title}>{tr[title]}</h3><p data-i18n={desc}>{tr[desc]}</p><div class="daily-options" id={`${id}-daily-options`}>
{id==='discount'&&<>{[{key:'price',label:'discountOriginal',value:'200'},{key:'percent',label:'discountRate',value:'15'}].map(({key,label,value})=><><label class="field-label" for={`discount-${key}`} data-i18n={label}>{tr[label as keyof typeof tr]}</label><input class="text-input" id={`discount-${key}`} type="text" inputmode="decimal" maxlength="100" value={value}/></>)}</>}
{id==='proportion'&&<><p class="number-hint" dir="ltr">A / B = C / D</p>{['a','b','c','d'].map((key,index)=><><label class="field-label" for={`proportion-${key}`}>{key.toUpperCase()}</label><input class="text-input" id={`proportion-${key}`} type="text" inputmode="decimal" maxlength="100" value={['2','3','4',''][index]}/></>)}</>}
{id==='travel'&&<><label class="field-label" for="travel-mode" data-i18n="travelFind">{tr.travelFind}</label><select class="text-input" id="travel-mode">{['speed','distance','time'].map(key=><option value={key} selected={key==='time'} data-i18n={'travel'+key[0].toUpperCase()+key.slice(1)}>{tr[('travel'+key[0].toUpperCase()+key.slice(1)) as keyof typeof tr]}</option>)}</select>{[{key:'speed',value:'60',units:['km/h','m/s','mph']},{key:'distance',value:'120',units:['km','m','mi']},{key:'time',value:'2',units:['h','min','s']}].map(({key,value,units})=><><label class="field-label" for={`travel-${key}`} data-i18n={'travel'+key[0].toUpperCase()+key.slice(1)}>{tr[('travel'+key[0].toUpperCase()+key.slice(1)) as keyof typeof tr]}</label><div class="daily-unit-row"><input class="text-input" id={`travel-${key}`} type="text" inputmode="decimal" maxlength="100" value={value}/><select class="text-input" id={`travel-${key}-unit`} data-i18n-aria="dailyUnit" aria-label={tr.dailyUnit}>{units.map(unit=><option value={unit}>{unit}</option>)}</select></div></>)}</>}
</div><small class="number-hint" data-i18n={hint}>{tr[hint]}</small><small class="number-hint" data-i18n="dailyNumberHint">{tr.dailyNumberHint}</small><button class="button-primary full" id={`${id}-daily-apply`} data-i18n="calculate">{tr.calculate}</button><label class="field-label" for={`${id}-daily-output`} data-i18n="textResult">{tr.textResult}</label><textarea class="text-input textarea text-result" id={`${id}-daily-output`} readonly dir="ltr"></textarea><p class="tool-feedback" id={`${id}-daily-feedback`} role="status"></p><div class="text-tool-actions"><button class="button-secondary full" id={`${id}-daily-copy`} data-i18n="copyResult" disabled>{tr.copyResult}</button><button class="button-secondary full" id={`${id}-daily-clear`} data-i18n="clearText">{tr.clearText}</button></div><div class="card-meta"><ShieldCheck size={14}/><span data-i18n="localColor">{tr.localColor}</span></div><a class="tool-more" data-tool-page={slug} href="#tools"><span data-i18n="navCta">{tr.navCta}</span><ArrowRight size={14}/></a></article>)}
<style is:global>.daily-options{display:flex;flex-direction:column;gap:7px;margin-bottom:10px}.daily-unit-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(80px,.6fr);gap:8px}.daily-options input:disabled{opacity:.45}</style>
