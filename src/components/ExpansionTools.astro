---
import{Wrench,ShieldCheck,ArrowRight}from'lucide-astro';import tr from'../i18n/locales/tr.json';const str=(key:string)=>tr[key as keyof typeof tr];const cards=[['pdfrotate','rotate-pdf-pages'],['pdfreorder','reorder-pdf-pages'],['pdfdelete','delete-pdf-pages'],['jsonyaml','json-to-yaml'],['yamljson','yaml-to-json'],['jsondiff','json-compare'],['stopwatch','stopwatch'],['pomodoro','pomodoro-timer'],['chance','coin-and-dice']];
---
{cards.map(([id,slug])=><article class="tool-card text-tool-card" id={`${id}-new-tool`}><div class="card-top"><span class="tool-icon icon-peach"><Wrench size={20}/></span><span class="tag-free" data-i18n="free">{tr.free}</span></div><h3 data-i18n={id+'Title'}>{str(id+'Title')}</h3><p data-i18n={id+'Desc'}>{str(id+'Desc')}</p>
{id.startsWith('pdf')?<><label class="field-label" for={`${id}-new-file`} data-i18n="pdfChooseOne">{tr.pdfChooseOne}</label><input class="text-input" id={`${id}-new-file`} type="file" accept="application/pdf,.pdf"/><small class="number-hint" data-i18n="pdfSplitLimits">{tr.pdfSplitLimits}</small><div class="expansion-options" id={`${id}-new-options`}>{id==='pdfrotate'&&<><label class="field-label" for="pdfrotate-angle" data-i18n="pdfEditAngle">{str('pdfEditAngle')}</label><select class="text-input" id="pdfrotate-angle"><option value="90">90°</option><option value="180">180°</option><option value="270">270°</option></select><label class="text-tool-options"><input id="pdfrotate-all" type="checkbox" checked/><span data-i18n="pdfEditAll">{str('pdfEditAll')}</span></label></>}<label class="field-label" for={`${id}-new-selection`} data-i18n={id==='pdfreorder'?'pdfEditOrder':'pdfRange'}>{str(id==='pdfreorder'?'pdfEditOrder':'pdfRange')}</label><input class="text-input" id={`${id}-new-selection`} maxlength="2000" placeholder={id==='pdfreorder'?'3,1-2':'1-3,5'} dir="ltr"/></div><small class="number-hint" data-i18n={id+'Hint'}>{str(id+'Hint')}</small><button class="button-primary full" id={`${id}-new-apply`} data-i18n="pdfEditApply" disabled>{str('pdfEditApply')}</button><button class="button-secondary full" id={`${id}-new-clear`} data-i18n="pdfClear">{tr.pdfClear}</button><p class="pdf-file-count"><span data-i18n="pdfPages">{tr.pdfPages}</span>: <b id={`${id}-new-pages`}>—</b></p><p class="tool-feedback" id={`${id}-new-feedback`} role="status"></p><button class="button-secondary full" id={`${id}-new-download`} data-i18n="pdfDownload" disabled>{tr.pdfDownload}</button></>:['jsonyaml','yamljson','jsondiff'].includes(id)?<><div class="expansion-options" id={`${id}-new-options`}><label class="field-label" for={`${id}-new-input`} data-i18n={id==='jsondiff'?'diffOriginal':'textInput'}>{str(id==='jsondiff'?'diffOriginal':'textInput')}</label><textarea class="text-input textarea" id={`${id}-new-input`} maxlength="100000" dir="ltr" spellcheck="false"></textarea>{id==='jsondiff'&&<><label class="field-label" for="jsondiff-second" data-i18n="diffUpdated">{tr.diffUpdated}</label><textarea class="text-input textarea" id="jsondiff-second" maxlength="100000" dir="ltr" spellcheck="false"></textarea></>}</div><small class="number-hint" data-i18n={id+'Hint'}>{str(id+'Hint')}</small><small class="number-hint" data-i18n="structuredLimits">{str('structuredLimits')}</small><button class="button-primary full" id={`${id}-new-apply`} data-i18n="utilityApply">{tr.utilityApply}</button><label class="field-label" for={`${id}-new-output`} data-i18n="textResult">{tr.textResult}</label><textarea class="text-input textarea text-result" id={`${id}-new-output`} readonly dir="ltr" spellcheck="false"></textarea><p class="tool-feedback" id={`${id}-new-feedback`} role="status"></p><div class="text-tool-actions"><button class="button-secondary full" id={`${id}-new-copy`} data-i18n="copyResult" disabled>{tr.copyResult}</button><button class="button-secondary full" id={`${id}-new-clear`} data-i18n="clearText">{tr.clearText}</button></div></>:id==='chance'?<><div class="expansion-options" id="chance-new-options"><label class="field-label" for="chance-mode" data-i18n="chanceMode">{str('chanceMode')}</label><select class="text-input" id="chance-mode"><option value="coin" data-i18n="chanceCoin">{str('chanceCoin')}</option><option value="dice" data-i18n="chanceDice">{str('chanceDice')}</option></select><label class="field-label" for="chance-count" data-i18n="chanceCount">{str('chanceCount')}</label><input class="text-input" id="chance-count" type="number" min="1" max="100" value="1"/></div><small class="number-hint" data-i18n="chanceHint">{str('chanceHint')}</small><button class="button-primary full" id="chance-apply" data-i18n="chanceDraw">{str('chanceDraw')}</button><label class="field-label" for="chance-output" data-i18n="textResult">{tr.textResult}</label><textarea class="text-input textarea text-result" id="chance-output" readonly></textarea><p class="tool-feedback" id="chance-feedback" role="status"></p><div class="text-tool-actions"><button class="button-secondary full" id="chance-copy" data-i18n="copyResult" disabled>{tr.copyResult}</button><button class="button-secondary full" id="chance-clear" data-i18n="clearText">{tr.clearText}</button></div></>:<>{id==='pomodoro'&&<div class="expansion-options" id="pomodoro-new-options"><label class="field-label" for="pomodoro-phase" data-i18n="pomodoroPhase">{str('pomodoroPhase')}</label><select class="text-input" id="pomodoro-phase"><option value="work" data-i18n="pomodoroWork">{str('pomodoroWork')}</option><option value="rest" data-i18n="pomodoroRest">{str('pomodoroRest')}</option></select>{[['work','pomodoroWorkMinutes','25','180'],['rest','pomodoroRestMinutes','5','60']].map(([key,label,value,max])=><><label class="field-label" for={`pomodoro-${key}`} data-i18n={label}>{str(label)}</label><input class="text-input" id={`pomodoro-${key}`} type="number" min="1" max={max} value={value}/></>)}</div>}<small class="number-hint" data-i18n={id+'Hint'}>{str(id+'Hint')}</small><output class="new-timer" id={`${id}-display`} aria-label={str(id+'Title')} data-i18n-aria={id+'Title'} dir="ltr">{id==='pomodoro'?'25:00':'00:00.0'}</output><div class="text-tool-actions"><button class="button-primary full" id={`${id}-start`} data-i18n="timerStart">{str('timerStart')}</button><button class="button-secondary full" id={`${id}-pause`} data-i18n="timerPause" disabled>{str('timerPause')}</button></div><button class="button-secondary full" id={`${id}-reset`} data-i18n="editorReset">{tr.editorReset}</button><p class="tool-feedback" id={`${id}-feedback`} role="status"></p></>}
<div class="card-meta"><ShieldCheck size={14}/><span data-i18n="privacyLine">{tr.privacyLine}</span></div><a class="tool-more" data-tool-page={slug} href="#tools"><span data-i18n="navCta">{tr.navCta}</span><ArrowRight size={14}/></a></article>)}
<style is:global>.expansion-options{display:flex;flex-direction:column;gap:7px;margin-bottom:10px}.new-timer{display:block;font-size:32px;line-height:1.5;text-align:center;font-variant-numeric:tabular-nums;color:#164c38;margin:14px 0}.text-tool-card>.new-timer{overflow-wrap:anywhere}</style>
