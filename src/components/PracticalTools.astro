---
import{Wrench,ShieldCheck,ArrowRight}from'lucide-astro';import tr from'../i18n/locales/tr.json';const str=(key:string)=>tr[key as keyof typeof tr];const cards=[['regex','regex-tester'],['htmlmd','html-to-markdown'],['mdpreview','markdown-preview'],['tipcalc','tip-split-calculator'],['fuelcalc','fuel-cost-calculator'],['dateadd','add-days-to-date']];
---
{cards.map(([id,slug])=><article class="tool-card text-tool-card" id={`${id}-suite-tool`}><div class="card-top"><span class="tool-icon icon-lilac"><Wrench size={20}/></span><span class="tag-free" data-i18n="free">{tr.free}</span></div><h3 data-i18n={id+'Title'}>{str(id+'Title')}</h3><p data-i18n={id+'Desc'}>{str(id+'Desc')}</p><div class="suite-options" id={`${id}-suite-options`}>
{['regex','htmlmd','mdpreview'].includes(id)&&<>{id==='regex'&&<><label class="field-label" for="regex-pattern" data-i18n="regexPattern">{str('regexPattern')}</label><input class="text-input" id="regex-pattern" maxlength="1000" value="\w+" dir="ltr" spellcheck="false"/><label class="field-label" for="regex-flags" data-i18n="regexFlags">{str('regexFlags')}</label><input class="text-input" id="regex-flags" maxlength="8" value="g" dir="ltr" spellcheck="false"/></>}<label class="field-label" for={`${id}-suite-input`} data-i18n="textInput">{tr.textInput}</label><textarea class="text-input textarea" id={`${id}-suite-input`} maxlength="100000" dir="auto" spellcheck="false"></textarea></>}
{id==='tipcalc'&&<>{[['bill','tipcalcBill','100'],['percent','tipcalcPercent','10'],['people','tipcalcPeople','2']].map(([key,label,value])=><><label class="field-label" for={`tipcalc-${key}`} data-i18n={label}>{str(label)}</label><input class="text-input" id={`tipcalc-${key}`} type="text" inputmode="decimal" maxlength="100" value={value}/></>)}</>}
{id==='fuelcalc'&&<>{[['distance','fuelcalcDistance','100'],['consumption','fuelcalcConsumption','7'],['price','fuelcalcPrice','50']].map(([key,label,value])=><><label class="field-label" for={`fuelcalc-${key}`} data-i18n={label}>{str(label)}</label><input class="text-input" id={`fuelcalc-${key}`} type="text" inputmode="decimal" maxlength="100" value={value}/></>)}</>}
{id==='dateadd'&&<><label class="field-label" for="dateadd-date" data-i18n="dateaddDate">{str('dateaddDate')}</label><input class="text-input" type="date" id="dateadd-date" min="0001-01-01" max="9999-12-31"/><label class="field-label" for="dateadd-days" data-i18n="dateaddDays">{str('dateaddDays')}</label><input class="text-input" id="dateadd-days" type="text" inputmode="numeric" value="7" maxlength="100"/></>}
</div><small class="number-hint" data-i18n={id+'Hint'}>{str(id+'Hint')}</small><button class="button-primary full" id={`${id}-suite-apply`} data-i18n={['tipcalc','fuelcalc','dateadd'].includes(id)?'calculate':'utilityApply'}>{str(['tipcalc','fuelcalc','dateadd'].includes(id)?'calculate':'utilityApply')}</button>{id==='mdpreview'&&<iframe class="markdown-frame" id="mdpreview-frame" sandbox="" referrerpolicy="no-referrer" title={str('mdpreviewTitle')} data-i18n-title="mdpreviewTitle" hidden></iframe>}<label class="field-label" for={`${id}-suite-output`} data-i18n="textResult">{tr.textResult}</label><textarea class="text-input textarea text-result" id={`${id}-suite-output`} readonly dir="auto"></textarea><p class="tool-feedback" id={`${id}-suite-feedback`} role="status"></p><div class="text-tool-actions"><button class="button-secondary full" id={`${id}-suite-copy`} data-i18n="copyResult" disabled>{tr.copyResult}</button><button class="button-secondary full" id={`${id}-suite-clear`} data-i18n="clearText">{tr.clearText}</button></div><div class="card-meta"><ShieldCheck size={14}/><span data-i18n="localWord">{tr.localWord}</span></div><a class="tool-more" data-tool-page={slug} href="#tools"><span data-i18n="navCta">{tr.navCta}</span><ArrowRight size={14}/></a></article>)}
<style is:global>.suite-options{display:flex;flex-direction:column;gap:7px;margin-bottom:10px}.markdown-frame{width:100%;height:300px;border:1px solid #dce5db;border-radius:8px;margin:12px 0}.markdown-frame[hidden]{display:none}</style>
