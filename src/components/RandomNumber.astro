---
import { Shuffle, ShieldCheck, ArrowRight } from 'lucide-astro';
import tr from '../i18n/locales/tr.json';
const str = (key: string) => (tr as Record<string, string>)[key] ?? key;
const fields = [
  { id: 'min', key: 'randomNumberMin', min: -1000000000, max: 1000000000, value: 1 },
  { id: 'max', key: 'randomNumberMax', min: -1000000000, max: 1000000000, value: 100 },
  { id: 'count', key: 'randomNumberCount', min: 1, max: 100, value: 10 },
];
---
<article class="tool-card random-number-card" id="random-number-tool">
  <div class="card-top"><span class="tool-icon icon-blue"><Shuffle size={20}/></span><span class="tag-free" data-i18n="free">{tr.free}</span></div>
  <h3 data-i18n="randomNumberTitle">{str('randomNumberTitle')}</h3>
  <p data-i18n="randomNumberDesc">{str('randomNumberDesc')}</p>
  <div class="random-number-options">
    {fields.map(field => <div><label class="field-label" for={`random-number-${field.id}`} data-i18n={field.key}>{str(field.key)}</label><input class="text-input" id={`random-number-${field.id}`} type="number" min={field.min} max={field.max} step="1" value={field.value} required aria-describedby="random-number-limits"/></div>)}
  </div>
  <small class="random-number-hint" id="random-number-limits" data-i18n="randomNumberLimits">{str('randomNumberLimits')}</small>
  <button class="button-primary full" id="random-number-generate" data-i18n="randomNumberGenerate">{str('randomNumberGenerate')}</button>
  <label class="field-label random-number-result-label" for="random-number-output" data-i18n="textResult">{tr.textResult}</label>
  <textarea class="text-input textarea text-result" id="random-number-output" readonly dir="ltr" spellcheck="false"></textarea>
  <p class="tool-feedback" id="random-number-feedback" role="status" aria-live="polite"></p>
  <div class="text-tool-actions"><button class="button-secondary full" id="random-number-copy" data-i18n="copyResult" disabled>{tr.copyResult}</button><button class="button-secondary full" id="random-number-clear" data-i18n="clearText">{tr.clearText}</button></div>
  <div class="card-meta"><ShieldCheck size={14}/><span data-i18n="localWord">{tr.localWord}</span></div>
  <a class="tool-more" data-tool-page="random-number-generator" href="#tools"><span data-i18n="navCta">{tr.navCta}</span><ArrowRight size={14}/></a>
</article>
<style is:global>
.random-number-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.random-number-options input{width:100%;min-width:0}
.random-number-hint{display:block;font-size:12px;line-height:1.65;color:#526258;margin:10px 0 14px}
.random-number-result-label{margin-top:14px}
.random-number-card textarea{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;min-height:160px}
@media(max-width:440px){.random-number-options{grid-template-columns:1fr}}
</style>
