---
import{Wrench,ShieldCheck,ArrowRight}from'lucide-astro';import tr from'../i18n/locales/tr.json';const str=(key:string)=>tr[key as keyof typeof tr];const cards=[['audiotrim','trim-audio'],['audiojoin','join-audio'],['audionormal','normalize-audio'],['primecheck','prime-number-checker'],['factorize','prime-factorization'],['gcdlcm','gcd-lcm-calculator'],['ipv4subnet','ipv4-subnet-calculator'],['ipv6format','ipv6-compress-expand'],['cidrcheck','ip-in-cidr']];
---
{cards.map(([id,slug])=><article class="tool-card text-tool-card" id={`${id}-lab-tool`}><div class="card-top"><span class="tool-icon icon-lilac"><Wrench size={20}/></span><span class="tag-free" data-i18n="free">{tr.free}</span></div><h3 data-i18n={id+'Title'}>{str(id+'Title')}</h3><p data-i18n={id+'Desc'}>{str(id+'Desc')}</p>
{id.startsWith('audio')?<><label class="field-label" for={`${id}-lab-file`} data-i18n="audioChoose">{str('audioChoose')}</label><input class="text-input" id={`${id}-lab-file`} type="file" accept="audio/*" multiple={id==='audiojoin'}/><small class="number-hint" data-i18n="audioLimits">{str('audioLimits')}</small><ol class="pdf-file-list" id={`${id}-lab-list`}></ol><fieldset class="editor-controls lab-options" id={`${id}-lab-options`} disabled>{id==='audiotrim'&&<>{[['start','audioStart','0'],['end','audioEnd','1']].map(([key,label,value])=><><label class="field-label" for={`audiotrim-${key}`} data-i18n={label}>{str(label)}</label><input class="text-input" id={`audiotrim-${key}`} type="text" inputmode="decimal" maxlength="100" value={value}/></>)}</>}{id==='audionormal'&&<><label class="field-label" for="audionormal-db" data-i18n="audioTarget">{str('audioTarget')}</label><input class="text-input" id="audionormal-db" type="number" min="-12" max="0" step="0.1" value="-1"/></>}</fieldset><small class="number-hint" data-i18n={id+'Hint'}>{str(id+'Hint')}</small><button class="button-primary full" id={`${id}-lab-apply`} data-i18n="audioProcess" disabled>{str('audioProcess')}</button><button class="button-secondary full" id={`${id}-lab-clear`} data-i18n="pdfClear">{tr.pdfClear}</button><audio class="lab-audio" id={`${id}-lab-player`} controls preload="metadata" hidden aria-label={str(id+'Title')} data-i18n-aria={id+'Title'}></audio><p class="number-hint" id={`${id}-lab-result`}>—</p><p class="tool-feedback" id={`${id}-lab-feedback`} role="status"></p><button class="button-secondary full" id={`${id}-lab-download`} data-i18n="audioDownload" disabled>{str('audioDownload')}</button></>:<><div class="lab-options" id={`${id}-lab-options`}><label class="field-label" for={`${id}-lab-input`} data-i18n={id==='cidrcheck'?'ipAddress':id==='ipv4subnet'?'cidrRange':id==='ipv6format'?'ipAddress':'numericValue'}>{str(id==='cidrcheck'?'ipAddress':id==='ipv4subnet'?'cidrRange':id==='ipv6format'?'ipAddress':'numericValue')}</label><input class="text-input" id={`${id}-lab-input`} type="text" maxlength="160" dir="ltr" value={id==='primecheck'?'97':id==='factorize'?'360':id==='gcdlcm'?'48':id==='ipv4subnet'?'192.168.1.10/24':id==='ipv6format'?'2001:0db8:0000:0000:0000:0000:0000:0001':'192.168.1.10'}/>{id==='gcdlcm'&&<><label class="field-label" for="gcdlcm-second" data-i18n="valueB">{tr.valueB}</label><input class="text-input" id="gcdlcm-second" maxlength="101" value="18" dir="ltr"/></>}{id==='cidrcheck'&&<><label class="field-label" for="cidrcheck-range" data-i18n="cidrRange">{str('cidrRange')}</label><input class="text-input" id="cidrcheck-range" maxlength="160" value="192.168.1.0/24" dir="ltr"/></>}</div><small class="number-hint" data-i18n={id+'Hint'}>{str(id+'Hint')}</small><button class="button-primary full" id={`${id}-lab-apply`} data-i18n="calculate">{tr.calculate}</button><label class="field-label" for={`${id}-lab-output`} data-i18n="textResult">{tr.textResult}</label><textarea class="text-input textarea text-result" id={`${id}-lab-output`} readonly dir="ltr"></textarea><p class="tool-feedback" id={`${id}-lab-feedback`} role="status"></p><div class="text-tool-actions"><button class="button-secondary full" id={`${id}-lab-copy`} data-i18n="copyResult" disabled>{tr.copyResult}</button><button class="button-secondary full" id={`${id}-lab-clear`} data-i18n="clearText">{tr.clearText}</button></div></>}
<div class="card-meta"><ShieldCheck size={14}/><span data-i18n="privacyLine">{tr.privacyLine}</span></div><a class="tool-more" data-tool-page={slug} href="#tools"><span data-i18n="navCta">{tr.navCta}</span><ArrowRight size={14}/></a></article>)}
<style is:global>.lab-options{display:flex;flex-direction:column;gap:7px;margin-bottom:10px}.lab-audio{display:block;width:100%;max-width:100%;margin:12px 0}.lab-audio[hidden]{display:none}</style>
