---
import{SearchCheck,ShieldCheck,ArrowRight}from'lucide-astro';import tr from'../i18n/locales/tr.json';const str=(key:string)=>tr[key as keyof typeof tr];const cards=[['anagram','anagram-checker'],['palindrome','palindrome-checker'],['emailextract','email-extractor']];
---
{cards.map(([id,slug])=><article class="tool-card text-tool-card" id={`${id}-check-tool`}><div class="card-top"><span class="tool-icon icon-peach"><SearchCheck size={20}/></span><span class="tag-free" data-i18n="free">{tr.free}</span></div><h3 data-i18n={id+'Title'}>{str(id+'Title')}</h3><p data-i18n={id+'Desc'}>{str(id+'Desc')}</p><div class="check-options" id={`${id}-check-options`}><label class="field-label" for={`${id}-check-input`} data-i18n={id==='anagram'?'diffOriginal':'textInput'}>{str(id==='anagram'?'diffOriginal':'textInput')}</label><textarea class="text-input textarea" id={`${id}-check-input`} maxlength="100000" dir="auto" spellcheck="false"></textarea>{id==='anagram'&&<><label class="field-label" for="anagram-second" data-i18n="diffUpdated">{tr.diffUpdated}</label><textarea class="text-input textarea" id="anagram-second" maxlength="100000" dir="auto" spellcheck="false"></textarea></>}{id==='emailextract'?<label class="text-tool-options"><input type="checkbox" id="emailextract-unique" checked/><span data-i18n="emailUnique">{str('emailUnique')}</span></label>:<>{[['lower','checkLower'],['letters','checkLetters']].map(([key,label])=><label class="text-tool-options"><input type="checkbox" id={`${id}-${key}`} checked/><span data-i18n={label}>{str(label)}</span></label>)}</>}</div><small class="number-hint" data-i18n={id+'Hint'}>{str(id+'Hint')}</small><button class="button-primary full" id={`${id}-check-apply`} data-i18n="checkTextApply">{str('checkTextApply')}</button><label class="field-label" for={`${id}-check-output`} data-i18n="textResult">{tr.textResult}</label><textarea class="text-input textarea text-result" id={`${id}-check-output`} readonly dir={id==='emailextract'?'ltr':'auto'}></textarea><p class="tool-feedback" id={`${id}-check-feedback`} role="status"></p><div class="text-tool-actions"><button class="button-secondary full" id={`${id}-check-copy`} data-i18n="copyResult" disabled>{tr.copyResult}</button><button class="button-secondary full" id={`${id}-check-clear`} data-i18n="clearText">{tr.clearText}</button></div><div class="card-meta"><ShieldCheck size={14}/><span data-i18n="localWord">{tr.localWord}</span></div><a class="tool-more" data-tool-page={slug} href="#tools"><span data-i18n="navCta">{tr.navCta}</span><ArrowRight size={14}/></a></article>)}
<style is:global>.check-options{display:flex;flex-direction:column;gap:7px;margin-bottom:10px}</style>
