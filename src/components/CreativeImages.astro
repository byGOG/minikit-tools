---
import{Image,ShieldCheck,ArrowRight}from'lucide-astro';import tr from'../i18n/locales/tr.json';const str=(key:string)=>tr[key as keyof typeof tr];const cards=[['combine','combine-images'],['blur','blur-image'],['invert','invert-image-colors']];
---
{cards.map(([id,slug])=><article class="tool-card text-tool-card image-editor-card" id={`${id}-creative-tool`}><div class="card-top"><span class="tool-icon icon-green"><Image size={20}/></span><span class="tag-free" data-i18n="free">{tr.free}</span></div><h3 data-i18n={id+'Title'}>{str(id+'Title')}</h3><p data-i18n={id+'Desc'}>{str(id+'Desc')}</p>
{id==='combine'?<><label class="field-label" for="combine-files" data-i18n="pdfChooseImages">{tr.pdfChooseImages}</label><input class="text-input" id="combine-files" type="file" accept="image/png,image/jpeg,image/webp" multiple/><ol class="pdf-file-list" id="combine-list"></ol><fieldset class="editor-controls" id="combine-options" disabled><label class="field-label" for="combine-direction" data-i18n="combineDirection">{str('combineDirection')}</label><select class="text-input" id="combine-direction"><option value="horizontal" data-i18n="combineHorizontal">{str('combineHorizontal')}</option><option value="vertical" data-i18n="combineVertical">{str('combineVertical')}</option></select></fieldset><small class="number-hint" data-i18n="combineHint">{str('combineHint')}</small><button class="button-primary full" id="combine-apply" data-i18n="effectApply" disabled>{tr.effectApply}</button><button class="button-secondary full" id="combine-clear" data-i18n="pdfClear">{tr.pdfClear}</button><div class="editor-preview"><img id="combine-preview" hidden alt={str('combineTitle')} data-i18n-alt="combineTitle"/></div><p class="editor-size"><span data-i18n="editorDimensions">{tr.editorDimensions}</span>: <b id="combine-size">—</b></p><p class="tool-feedback" id="combine-feedback" role="status"></p><button class="button-secondary full" id="combine-download" data-i18n="downloadPng" disabled>{tr.downloadPng}</button></>:<><label class="field-label" for={`${id}-creative-file`} data-i18n="editorFile">{tr.editorFile}</label><input class="text-input" id={`${id}-creative-file`} type="file" accept="image/png,image/jpeg,image/webp"/><small class="number-hint" data-i18n="editorLimits">{tr.editorLimits}</small><p class="editor-selected" id={`${id}-creative-selected`}></p><fieldset class="editor-controls" id={`${id}-creative-options`} disabled>{id==='blur'&&<><label class="field-label" for="blur-radius" data-i18n="blurRadius">{str('blurRadius')}</label><input class="text-input" type="number" id="blur-radius" min="0" max="50" value="5"/></>}<button class="button-secondary full" id={`${id}-creative-reset`} data-i18n="editorReset">{tr.editorReset}</button></fieldset><small class="number-hint" data-i18n={id+'Hint'}>{str(id+'Hint')}</small><button class="button-primary full" id={`${id}-creative-apply`} data-i18n="effectApply" disabled>{tr.effectApply}</button><div class="editor-preview"><img id={`${id}-creative-preview`} hidden alt={str(id+'Title')} data-i18n-alt={id+'Title'}/></div><p class="editor-size"><span data-i18n="editorDimensions">{tr.editorDimensions}</span>: <b id={`${id}-creative-size`}>—</b></p><p class="tool-feedback" id={`${id}-creative-feedback`} role="status"></p><button class="button-secondary full" id={`${id}-creative-download`} data-i18n="downloadPng" disabled>{tr.downloadPng}</button></>}
<div class="card-meta"><ShieldCheck size={14}/><span data-i18n="localImage">{tr.localImage}</span></div><a class="tool-more" data-tool-page={slug} href="#tools"><span data-i18n="navCta">{tr.navCta}</span><ArrowRight size={14}/></a></article>)}
