---
import settings from '../data/advertising.json';
import {validateAdvertising} from '../scripts/advertising-config';
const advertising = validateAdvertising(settings);
const { advertisements = true, canonical } = Astro.props;
const { title = 'MiniKit — Useful tools, beautifully simple', description = 'Free, private online tools for everyday tasks.', lang = 'tr' } = Astro.props;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '8K9Ztxk2nPpLHGa3kvZN2pRl_p17WoNTTNkgb612X2c';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {advertisements && advertising.publisherId && <meta name="google-adsense-account" content={advertising.publisherId} />}
    {advertisements && advertising.enabled && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${advertising.publisherId}`} crossorigin="anonymous"></script>}
    <meta name="theme-color" content="#f8faf7" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title>
  </head>
  <body class="bg-paper font-sans text-ink antialiased"><slot /></body>
</html>

