---
import Layout from '../layouts/Layout.astro';
import TextTools from '../components/TextTools.astro';
import tools from '../data/tools.json';
import { Image, QrCode, Type, Pipette, ArrowRight, ShieldCheck, Zap, Globe2, Menu, Sparkles, Check, Download, Upload, Copy, RotateCcw } from 'lucide-astro';
---
<Layout title="MiniKit — Günlük işler için ücretsiz araçlar" description="Görselini dönüştür, QR kod oluştur, metnini say ve renklerini çevir. Ücretsiz, hızlı ve gizli." lang="tr">
  <a class="skip-link" href="#tools" data-i18n="skipTools">Skip to tools</a><div class="announcement"><Sparkles size={15} /><span data-i18n="announcement">Küçük işler, daha kolay. MiniKit şimdi yayında.</span><a href="#tools" data-i18n="explore">Keşfet <ArrowRight size={14}/></a></div>
  <header class="site-header"><a class="brand" href="#top" data-i18n-aria="homeLabel" aria-label="MiniKit home"><span class="brand-mark"><span></span><span></span><span></span><span></span></span><span>mini<span class="brand-bold">kit</span><span class="brand-dot">.</span></span></a><nav class="desktop-nav" data-i18n-aria="mainNavigation" aria-label="Main navigation"><a href="#tools" data-i18n="navTools">Araçlar</a><a href="#why" data-i18n="navWhy">Neden MiniKit?</a><a href="#privacy" data-i18n="navPrivacy">Gizlilik</a></nav><div class="header-actions"><label class="language-picker" data-i18n-aria="chooseLanguage" aria-label="Language"><Globe2 size={16}/><select id="language-select" class="lang-switch" data-i18n-aria="chooseLanguage" aria-label="Choose language"><option value="tr">Türkçe</option><option value="en">English</option><option value="es">Español</option><option value="de">Deutsch</option><option value="fr">Français</option><option value="pt">Português</option><option value="ru">Русский</option><option value="it">Italiano</option><option value="ar">العربية</option><option value="zh">简体中文</option><option value="ja">日本語</option><option value="hi">हिन्दी</option><option value="id">Bahasa Indonesia</option></select></label><a class="header-cta" href="#tools"><span data-i18n="navCta">Araçları keşfet</span><ArrowRight size={16}/></a><button id="mobile-menu-btn" class="mobile-menu" data-i18n-aria="menuOpen" aria-label="Open menu" aria-controls="mobile-nav" aria-expanded="false"><Menu size={22}/></button></div></header>
  <main id="top">
    <section class="hero"><div class="hero-copy"><div class="eyebrow"><span class="live-dot"></span><span data-i18n="eyebrow">HER GÜN İŞE YARAYAN ARAÇLAR</span></div><h1 data-i18n="heroTitle">Günlük işler için<br/><span>küçük bir kısayol.</span></h1><p class="hero-lede" data-i18n="heroLead">Görseli dönüştür, QR kod oluştur, metnini say. İhtiyacın olan pratik araçlar, tek bir sakin yerde.</p><div class="hero-actions"><a class="button-primary" href="#tools"><span data-i18n="heroCta">Ücretsiz araçları dene</span><ArrowRight size={18}/></a><div class="hero-proof"><div class="proof-avatars"><span>✳</span><span>◉</span><span>⌘</span></div><span data-i18n="heroProof">Hesap gerekmez · Hep ücretsiz</span></div></div><div class="hero-privacy"><ShieldCheck size={16}/><span data-i18n="privacyLine">Dosyaların cihazında kalır. Yükleme yok, hesap yok.</span></div></div>
      <div class="hero-art" aria-hidden="true"><div class="art-glow"></div><div class="float-chip chip-image"><Image size={16}/><span>image.webp</span><span class="chip-tag">−68%</span></div><div class="float-chip chip-check"><span class="check-dot"><Check size={12}/></span><span data-i18n="ready">Hazır!</span></div><div class="dashboard-card"><div class="dash-top"><span class="dash-logo"><span></span><span></span><span></span><span></span></span><span class="dash-menu">•••</span></div><div class="dash-title" data-i18n="quickTools">Hızlı araçlar</div><div class="dash-sub" data-i18n="pickTool">Bugün ne yapmak istersin?</div><div class="dash-tools"><div><span class="dash-icon green"><Image size={19}/></span><small data-i18n="compress">Görsel sıkıştır</small></div><div><span class="dash-icon lilac"><QrCode size={19}/></span><small data-i18n="makeQr">QR kod oluştur</small></div><div><span class="dash-icon peach"><Type size={19}/></span><small data-i18n="countWords">Kelime say</small></div><div><span class="dash-icon blue"><Pipette size={19}/></span><small data-i18n="convertColor">Renk dönüştür</small></div></div><div class="dash-private"><ShieldCheck size={14}/><span data-i18n="privateDevice">%100 cihazında. Her zaman gizli.</span></div></div><div class="art-spark spark-one">✳</div><div class="art-spark spark-two">✦</div><div class="art-orbit"></div></div>
    </section>
    <section class="trust-strip"><div><Zap size={16}/><span data-i18n="statFast">Anında çalışır</span></div><i></i><div><ShieldCheck size={16}/><span data-i18n="statPrivate">Gizlilik önce gelir</span></div><i></i><div><Globe2 size={16}/><span data-i18n="statFree">Ücretsiz ve kolay</span></div><i></i><div><Sparkles size={16}/><span data-i18n="statNew">Her hafta yeni araçlar</span></div></section>
    <section class="tools-section" id="tools"><div class="section-heading"><div><div class="eyebrow"><span class="eyebrow-mark">✳</span><span data-i18n="toolsEyebrow">ARAÇ KUTUN</span></div><h2 data-i18n="toolsTitle">İşini gören araçlar.<br/><span>Gereksiz kalabalık yok.</span></h2></div><span class="tool-count"><span class="live-dot"></span><b id="tool-total">{String(tools.length).padStart(2, '0')}</b> <span data-i18n="toolsAvailable">araç hazır</span></span></div>
      <div class="tool-grid">
        <article class="tool-card image-card" id="image-tool"><div class="card-top"><span class="tool-icon icon-green"><Image size={20}/></span><span class="tag-free" data-i18n="free">ÜCRETSİZ</span></div><h3 data-i18n="imageTitle">Görsel dönüştürücü</h3><p data-i18n="imageDesc">Görsellerini WebP, JPEG veya PNG’ye dönüştür ya da boyutunu küçült.</p><label class="upload-zone" for="image-file"><input type="file" id="image-file" accept="image/*"/><Upload size={19}/><span data-i18n="uploadChoose">Görsel seç veya sürükle bırak</span><small data-i18n="fileLimit">JPG, PNG, WEBP · En fazla 20 MB</small></label><div class="image-controls hidden" id="image-controls"><div class="control-row"><label for="image-format" data-i18n="outputFormat">Çıktı formatı</label><select id="image-format"><option value="image/webp">WebP</option><option value="image/jpeg">JPEG</option><option value="image/png">PNG</option></select></div><div class="control-row"><label for="image-quality"><span data-i18n="quality">Kalite</span> <b id="quality-value">82%</b></label><input type="range" id="image-quality" min="30" max="100" value="82"/></div><div class="selected-file" id="selected-file"></div><button class="button-primary full" id="convert-image"><span data-i18n="convertDownload">Dönüştür ve indir</span><Download size={16}/></button><p class="tool-feedback" id="image-feedback" role="status"></p></div><div class="card-meta"><ShieldCheck size={14}/><span data-i18n="localImage">Görselin cihazında işlenir</span></div><a class="tool-more" data-tool-page="image-converter" href="#tools"><span data-i18n="navCta">Araçları keşfet</span><ArrowRight size={14}/></a></article>
        <article class="tool-card" id="qr-tool"><div class="card-top"><span class="tool-icon icon-lilac"><QrCode size={20}/></span><span class="tag-free" data-i18n="free">ÜCRETSİZ</span></div><h3 data-i18n="qrTitle">QR kod oluşturucu</h3><p data-i18n="qrDesc">Bir bağlantı veya kısa metin yaz; QR kodunu indirip paylaş.</p><label class="field-label" for="qr-input" data-i18n="qrLabel">Bağlantı veya metin</label><input class="text-input" id="qr-input" maxlength="1200" placeholder="https://example.com"/><div class="qr-preview" id="qr-preview"><div class="qr-empty" data-i18n="qrEmpty">QR kodun burada görünecek</div><img class="hidden" id="qr-image" data-i18n-alt="qrTitle" alt="Generated QR code"/></div><button class="button-primary full" id="generate-qr"><span data-i18n="generateQr">QR kod oluştur</span><ArrowRight size={16}/></button><button class="button-secondary full hidden" id="download-qr"><span data-i18n="downloadQr">QR kodu indir</span><Download size={16}/></button><p class="tool-feedback" id="qr-feedback" role="status"></p><div class="card-meta"><ShieldCheck size={14}/><span data-i18n="localQr">Kodun bu cihazda oluşturulur</span></div><a class="tool-more" data-tool-page="qr-code-generator" href="#tools"><span data-i18n="navCta">Araçları keşfet</span><ArrowRight size={14}/></a></article>
        <article class="tool-card" id="word-tool"><div class="card-top"><span class="tool-icon icon-peach"><Type size={20}/></span><span class="tag-free" data-i18n="free">ÜCRETSİZ</span></div><h3 data-i18n="wordTitle">Kelime sayacı</h3><p data-i18n="wordDesc">Kelime, karakter ve okuma süresi sayını anında öğren.</p><label class="field-label" for="word-input" data-i18n="pasteText">Metnini buraya yaz</label><textarea class="text-input textarea" id="word-input" data-i18n-placeholder="pasteText" maxlength="100000" placeholder="Bir şeyler yazmaya başla..."></textarea><div class="word-stats" role="status" aria-live="polite" aria-atomic="true"><div><b id="word-count">0</b><span data-i18n="words">Kelime</span></div><div><b id="char-count">0</b><span data-i18n="characters">Karakter</span></div><div><b id="read-time">0 sn</b><span data-i18n="readTime">Okuma süresi</span></div></div><button class="button-secondary full" id="clear-text"><span data-i18n="clearText">Metni temizle</span><RotateCcw size={15}/></button><p class="tool-feedback" id="word-feedback" role="status"></p><div class="card-meta"><ShieldCheck size={14}/><span data-i18n="localWord">Metnin cihazından çıkmaz</span></div><a class="tool-more" data-tool-page="word-counter" href="#tools"><span data-i18n="navCta">Araçları keşfet</span><ArrowRight size={14}/></a></article>
        <article class="tool-card" id="color-tool"><div class="card-top"><span class="tool-icon icon-blue"><Pipette size={20}/></span><span class="tag-free" data-i18n="free">ÜCRETSİZ</span></div><h3 data-i18n="colorTitle">Renk dönüştürücü</h3><p data-i18n="colorDesc">HEX, RGB ve HSL değerleri arasında kolayca geçiş yap.</p><label class="field-label" for="color-hex" data-i18n="chooseColor">Bir renk seç</label><div class="color-pick-row"><input type="color" id="color-picker" value="#155c42"/><input class="text-input" id="color-hex" value="#155C42" maxlength="7" aria-label="HEX color"/></div><div class="color-values"><div class="color-value"><span>RGB</span><b id="rgb-value">21, 92, 66</b><button data-copy="rgb" aria-label="Copy RGB"><Copy size={15}/></button></div><div class="color-value"><span>HSL</span><b id="hsl-value">159, 63%, 22%</b><button data-copy="hsl" aria-label="Copy HSL"><Copy size={15}/></button></div></div><div class="color-swatch"><span id="swatch"></span><div><b data-i18n="preview">Önizleme</b><small id="swatch-label">#155C42</small></div></div><p class="tool-feedback" id="color-feedback" role="status"></p><div class="card-meta"><ShieldCheck size={14}/><span data-i18n="localColor">Değerler anında hesaplanır</span></div><a class="tool-more" data-tool-page="color-converter" href="#tools"><span data-i18n="navCta">Araçları keşfet</span><ArrowRight size={14}/></a></article>
        <TextTools />
      </div>
    </section>
    <section class="why-section" id="why"><div class="why-copy"><div class="eyebrow"><span class="eyebrow-mark">✳</span><span data-i18n="whyEyebrow">DAHA AZ UĞRAŞ, DAHA ÇOK İŞ</span></div><h2 data-i18n="whyTitle">Araç aramaya<br/>değil, işine odaklan.</h2><p data-i18n="whyLead">Her küçük iş için başka bir siteye gitmen gerekmiyor. MiniKit, en sık kullandığın pratik araçları temiz ve anlaşılır bir yerde toplar.</p><a class="text-link" href="#tools"><span data-i18n="allTools">Araçları keşfet</span><ArrowRight size={16}/></a></div><div class="benefit-list"><article><span class="benefit-number">01</span><div><h3 data-i18n="benefitOneTitle">Gerçekten hızlı</h3><p data-i18n="benefitOne">Aç, yap, bitir. İndirme yok, kayıt formu yok, beklemek yok.</p></div><span class="benefit-icon"><Zap size={18}/></span></article><article><span class="benefit-number">02</span><div><h3 data-i18n="benefitTwoTitle">Önce gizlilik</h3><p data-i18n="benefitTwo">Dosyaların ve metnin cihazından ayrılmaz. Verilerini saklamayız.</p></div><span class="benefit-icon"><ShieldCheck size={18}/></span></article><article><span class="benefit-number">03</span><div><h3 data-i18n="benefitThreeTitle">Herkes için basit</h3><p data-i18n="benefitThree">Kafa karıştıran menüler yok. Aradığın şey, tam da olması gereken yerde.</p></div><span class="benefit-icon"><Sparkles size={18}/></span></article></div></section>
    <section class="privacy-section" id="privacy"><div class="privacy-symbol"><ShieldCheck size={25}/></div><div><div class="eyebrow"><span data-i18n="privacyEyebrow">TASARLANDIĞI GİBİ GİZLİ</span></div><h2 data-i18n="privacyTitle">Dosyaların bize<br/><span>uğramadan işini görür.</span></h2><p data-i18n="privacyLead">Görsellerini tarayıcında işleriz. QR kodlarını ve renklerini cihazında oluştururuz. Yazdıkların seninle kalır. Kullanım analitiği veya reklam servisleri eklenirse bu bildirim güncellenir.</p></div><span class="privacy-stamp"><ShieldCheck size={15}/><span data-i18n="privacyStamp">GİZLİLİK ÖNCE GELİR</span></span></section>
    <section class="bottom-cta"><div><span class="cta-spark">✳</span><h2 data-i18n="ctaTitle">Bir sonraki küçük işin<br/>daha kolay olsun.</h2><p data-i18n="ctaLead">İlk aracını hemen dene. Ücretsiz, hesapsız, zahmetsiz.</p></div><a class="button-primary button-light" href="#tools"><span data-i18n="ctaButton">Hadi başlayalım</span><ArrowRight size={18}/></a><div class="cta-decoration">✳</div></section>
  </main>
  <footer class="site-footer"><a class="brand" href="#top"><span class="brand-mark"><span></span><span></span><span></span><span></span></span><span>mini<span class="brand-bold">kit</span><span class="brand-dot">.</span></span></a><p data-i18n="footerLine">Günlük işler için küçük kısayollar.</p><div class="footer-right"><span data-i18n="madeWith">Dikkatle yapıldı, herkes için.</span><span>© <span id="year"></span> MiniKit</span></div></footer>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script>
    import '../scripts/app.ts';
  </script>
</Layout>

<style is:global>
  :root{font-family:'DM Sans',sans-serif;scroll-behavior:smooth;scroll-padding-top:90px;color:#15251e;background:#f8faf7;font-synthesis:none;text-rendering:optimizeLegibility}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}.announcement{min-height:38px;display:flex;justify-content:center;align-items:center;gap:9px;background:#e9f5dc;color:#24533b;font-size:12px;font-weight:600}.announcement>a{display:flex;align-items:center;gap:4px;text-decoration:underline;text-underline-offset:3px;margin-left:3px}.site-header{height:78px;display:flex;align-items:center;justify-content:space-between;max-width:1190px;padding:0 24px;margin:auto;border-bottom:1px solid #e9ede8}.brand{display:flex;align-items:center;gap:9px;font-family:Manrope,sans-serif;font-size:21px;font-weight:500;letter-spacing:-1px}.brand-bold{font-weight:800}.brand-dot{color:#79ae40}.brand-mark,.dash-logo{width:25px;height:25px;background:#155c42;border-radius:8px;display:grid;grid-template-columns:1fr 1fr;gap:3px;padding:6px;transform:rotate(-4deg)}.brand-mark span,.dash-logo span{background:#c7f36b;border-radius:2px}.desktop-nav{display:flex;gap:36px;margin-left:48px}.desktop-nav a{font-size:13px;color:#68756d;font-weight:500;transition:color .2s}.desktop-nav a:hover{color:#155c42}.header-actions{display:flex;align-items:center;gap:14px}.lang-switch{height:35px;background:transparent;border:1px solid #e2e8e1;border-radius:9px;padding:0 10px;display:flex;align-items:center;gap:7px;color:#506157;cursor:pointer;font-size:11px;font-weight:700}.header-cta,.button-primary{background:#155c42;color:#fff;border:none;border-radius:10px;padding:12px 16px;display:inline-flex;align-items:center;justify-content:center;gap:10px;font-size:12px;font-weight:700;cursor:pointer;transition:background .2s,transform .2s}.header-cta{padding:10px 13px}.header-cta:hover,.button-primary:hover{background:#104a34;transform:translateY(-1px)}.mobile-menu{display:none;borde